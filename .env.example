# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: which Gemini model to use for script writing.
# "gemini-flash-latest" is an alias that always points at Google's current
# recommended flash model, so it won't go stale when they retire versions.
# If you want to pin a specific version instead, list what's on your key:
# python3 -c "import google.generativeai as genai, os; from dotenv import load_dotenv; load_dotenv(); genai.configure(api_key=os.environ['GEMINI_API_KEY']); [print(m.name) for m in genai.list_models()]"
GEMINI_MODEL=gemini-flash-latest

# Optional: edge-tts voice (free, default engine). Run `edge-tts --list-voices`
# to see all options. Good English defaults: en-US-GuyNeural (male),
# en-US-JennyNeural (female), en-GB-RyanNeural
TTS_VOICE=en-US-GuyNeural

# Optional: enables a fallback extractor for JS-rendered/paywalled pages that
# trafilatura can't read. Free tier = 1,000 pages/month, no card required.
# Get a key at https://firecrawl.dev -- leave blank to skip the fallback.
FIRECRAWL_API_KEY=

# Optional: enables a premium, more natural-sounding voice as a per-article
# toggle in the UI. Free tier is ~10,000 characters/month (~10 min of audio,
# non-commercial use only), so it's meant as an occasional upgrade, not the
# default engine. Get a key at https://elevenlabs.io -- leave blank to hide
# the toggle (the app will just use the free edge-tts voice).
ELEVENLABS_API_KEY=
# Optional: which ElevenLabs voice to use. Defaults to "Rachel" (a standard
# premade voice). Browse voices/IDs at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
